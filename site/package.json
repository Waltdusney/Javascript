{
  "name": "trader-scanner-site",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./input.css -o ./styles.css --minify && npm run vendor",
    "dev": "tailwindcss -i ./input.css -o ./styles.css --watch",
    "vendor": "mkdir -p vendor && cp node_modules/motion/dist/motion.js vendor/motion.js"
  },
  "devDependencies": {
    "tailwindcss": "3.4.16"
  },
  "dependencies": {
    "motion": "14.10.1"
  }
}
